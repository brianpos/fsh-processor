<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Hl7.FhirShorthand.Compiler_r4</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageId>Hl7.FhirShorthand.Compiler.R4</PackageId>
    <Title>HL7 FHIR Shorthand Compiler — R4</Title>
    <Description>FHIR R4 (4.0.1) adapter for the Hl7.FhirShorthand.Compiler base package. Provides R4FshCompiler to compile a parsed FshDoc into FHIR R4 resources.</Description>
    <PackageTags>FHIR;FSH;FHIRShorthand;HL7;compiler;R4</PackageTags>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hl7.Fhir.R4" Version="5.13.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\LICENSE.txt" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\fsh-compiler\Hl7.FhirShorthand.Compiler.csproj" />
  </ItemGroup>

</Project>
