<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Hl7.FhirShorthand.Serialization</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageId>Hl7.FhirShorthand.Serialization</PackageId>
    <Title>HL7 FHIR Shorthand Serialization</Title>
    <Description>Parse and serialize FHIR Shorthand (FSH) text. Produces a strongly-typed object model (FshDoc) that can be inspected, transformed, and round-tripped back to FSH with full comment and whitespace fidelity.</Description>
    <PackageTags>FHIR;FSH;FHIRShorthand;HL7;parser;serializer</PackageTags>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Antlr4.Runtime.Standard" Version="4.13.1" />
		<PackageReference Include="Hl7.Fhir.Conformance" Version="5.13.2" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="..\LICENSE.txt" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
