<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Hl7.FhirShorthand.Compiler_tester_r4</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Firely.Fhir.Packages" Version="4.9.1" />
    <PackageReference Include="Hl7.Fhir.Specification.Data.R4" Version="5.13.2" />
    <PackageReference Include="JsonDiffPatch.Net" Version="2.5.0" />
    <PackageReference Include="MSTest" Version="4.0.1" />
    <PackageReference Include="Hl7.Fhir.R4" Version="5.13.2" />
    <PackageReference Include="YamlDotNet" Version="17.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\fsh-compiler-R4\Hl7.FhirShorthand.Compiler.R4.csproj" />
    <ProjectReference Include="..\fsh-processor\Hl7.FhirShorthand.Serialization.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copy SDC IG test data from the parser tester project so the integration tests can load it -->
    <Content Include="..\fsh-tester\TestData\**\*.fsh" CopyToOutputDirectory="PreserveNewest">
      <Link>TestData\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>

		<!-- Copy SDC IG test data from the parser tester project so the integration tests can load it -->
		<Content Include="..\fsh-tester\TestData\**\*.yaml" CopyToOutputDirectory="PreserveNewest">
			<Link>TestData\%(RecursiveDir)%(Filename)%(Extension)</Link>
		</Content>

		<!-- Copy SDC IG test data from the parser tester project so the integration tests can load it -->
		<Content Include="TestData\**\*.json" CopyToOutputDirectory="PreserveNewest">
			<Link>TestData\%(RecursiveDir)%(Filename)%(Extension)</Link>
		</Content>
	</ItemGroup>

  <ItemGroup>
    <None Update="TestData\sushi-config.yaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
